// Copy to Local.xcconfig (gitignored) and fill in your own values.
//
// DEVELOPMENT_TEAM: your Apple Developer team ID (Xcode > Settings >
// Accounts, or developer.apple.com > Membership). Leave empty to build
// without signing for the simulator and macOS.
DEVELOPMENT_TEAM =

// A reverse-DNS prefix you control. Bundle IDs become
// $(BUNDLE_ID_PREFIX).clench and $(BUNDLE_ID_PREFIX).clench.share, and the
// App Group group.$(BUNDLE_ID_PREFIX).clench.
BUNDLE_ID_PREFIX = com.example
